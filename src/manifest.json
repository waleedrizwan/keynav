{
  "manifest_version": 3,
  "name": "Keynav",
  "version": "0.1.0",
  "description": "Mouse-free browsing: label every clickable element and hit it with the keyboard.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
