{
  "name": "keynav",
  "version": "0.1.0",
  "private": true,
  "description": "Mouse-free browsing for Chrome: label every clickable element and hit it with the keyboard.",
  "license": "MIT",
  "author": "Waleed Rizwan",
  "repository": {
    "type": "git",
    "url": "https://github.com/waleedrizwan/keynav.git"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "icons": "node scripts/icons.js",
    "package": "node scripts/package.js"
  },
  "engines": {
    "node": ">=22.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
